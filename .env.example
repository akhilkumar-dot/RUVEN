# FounderBridge — Environment Variables
# Copy this file to .env.local and fill in the values. Never commit real credentials.

# ===== Database =====
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/founderbridge
SPRING_DATASOURCE_USERNAME=founderbridge
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# ===== Redis =====
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379

# ===== JWT =====
FB_JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING
FB_JWT_ACCESS_EXPIRY_SECONDS=900
FB_JWT_REFRESH_EXPIRY_DAYS=30

# ===== Object Storage (Cloudflare R2 or AWS S3) =====
FB_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
FB_STORAGE_ACCESS_KEY=CHANGE_ME
FB_STORAGE_SECRET_KEY=CHANGE_ME
FB_STORAGE_BUCKET=founderbridge
FB_STORAGE_REGION=auto

# ===== Email (Resend) =====
FB_EMAIL_PROVIDER=resend
FB_EMAIL_RESEND_API_KEY=re_CHANGE_ME
FB_EMAIL_FROM=noreply@yourdomain.com

# ===== OAuth: Google =====
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME

# ===== OAuth: LinkedIn =====
LINKEDIN_CLIENT_ID=CHANGE_ME
LINKEDIN_CLIENT_SECRET=CHANGE_ME

# ===== OAuth: X (Twitter) — behind feature flag, disabled by default =====
TWITTER_CLIENT_ID=CHANGE_ME
TWITTER_CLIENT_SECRET=CHANGE_ME

# ===== OAuth: GitHub — behind feature flag, disabled by default =====
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME

# ===== Razorpay =====
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME
RAZORPAY_PRO_PLAN_ID=plan_CHANGE_ME

# ===== VAPID (Web Push) =====
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ===== Sentry (optional) =====
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ===== Feature Flags =====
FF_OAUTH_TWITTER=false
FF_OAUTH_GITHUB=false
FF_WEB_PUSH=false
FF_REALTIME_CODOC=false

# ===== Application =====
FB_FRONTEND_URL=https://yourdomain.com
FB_BACKEND_URL=https://api.yourdomain.com
FB_COOKIE_DOMAIN=yourdomain.com

# ===== Next.js (frontend) =====
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
